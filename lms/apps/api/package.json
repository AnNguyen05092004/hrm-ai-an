{
  "name": "@lms/api",
  "private": true,
  "description": "API FastAPI (Python 3.12, uv). Các lệnh npm chỉ gọi uv cho tiện chạy chung với web",
  "scripts": {
    "setup": "uv sync",
    "dev": "uv run uvicorn --factory app.main:serve --host 127.0.0.1 --port ${API_PORT:-4100} --reload --reload-dir app",
    "start": "uv run uvicorn --factory app.main:serve --host 127.0.0.1 --port ${API_PORT:-4100}",
    "worker": "uv run python -m app.worker",
    "test": "uv run pytest -q",
    "lint": "uv run ruff check app tests migrations",
    "db:migrate": "uv run python -m app.cli migrate",
    "db:seed": "uv run python -m app.cli seed"
  }
}
