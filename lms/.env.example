DATABASE_URL=postgres://lms:lms@localhost:54329/lms_studio
TEST_DATABASE_URL=postgres://lms:lms@localhost:54329/lms_studio_test
PORT=4100
WEB_ORIGIN=http://localhost:5194
SESSION_DAYS=14
STORAGE_DIR=./storage
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_MODEL_STRONG=gpt-5.4
AI_EMBED_MODEL=text-embedding-3-small
AI_TTS_MODEL=gpt-4o-mini-tts
AI_IMAGE_MODEL=gpt-image-2

# Bản demo: bỏ màn đăng nhập, đổi vai ở góc dưới thanh bên (mặc định bật khi không phải production)
# DEMO_MODE=true

# Email thông báo (mời review, nhắc hạn, kết luận, kết quả gửi LMS): smtp | console | off
# Máy phát triển gửi vào Mailpit (docker compose), xem thư ở http://localhost:8025
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=false
MAIL_FROM="LMS Studio <no-reply@studio.local>"

# LMS công ty nhận gói SCORM / QTI qua API. Máy phát triển: LMS demo ở cổng 5196.
# npm start tự sinh LMS_API_TOKEN nếu còn trống; để trống LMS_API_URL thì chỉ tải gói về
LMS_API_URL=http://127.0.0.1:5196/lms-api
LMS_API_TOKEN=
LMS_NAME=LMS công ty
