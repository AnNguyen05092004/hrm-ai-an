{
  "name": "lms",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "bash scripts/start.sh",
    "reset": "bash scripts/start.sh --reset",
    "db:up": "docker compose up -d db",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api"
  }
}
